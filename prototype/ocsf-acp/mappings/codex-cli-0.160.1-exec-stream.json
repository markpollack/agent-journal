{
  "contract_uid": "codex-cli/exec-json-stream/0.160.1/0.1.0-prototype",
  "applies_to": {
    "product": "Codex CLI",
    "version": "0.160.1",
    "launch": "codex exec --json",
    "source_kind": "Live output"
  },
  "record_discriminator": "type, then item.type",
  "time_policy": {
    "reported": "none: the exec stream carries no timestamps",
    "fallback": "capture start for every record"
  },
  "tool_kind_table": {
    "rule": "codex.tool_name_to_kind.v1",
    "map": {
      "exec": 6
    },
    "default": 99
  },
  "rules": [
    {
      "id": "codex.stream.agent_message->model_response",
      "selector": {
        "type": "item.completed",
        "item.type": "agent_message"
      },
      "target": "agentic_cli/model_response",
      "activity": "2 Completed",
      "owner": "response_uid = item.id (stream-scoped id such as item_0; it does not occur in the rollout, R13-08)"
    },
    {
      "id": "codex.stream.command_execution->tool_call.operation",
      "selector": {
        "type": [
          "item.started",
          "item.completed"
        ],
        "item.type": "command_execution"
      },
      "target": "agentic_cli/tool_call",
      "activity": "3 Operation observed",
      "attribution": {
        "rule": "codex.stream_operation_attribution.v1",
        "outcome": "3 Unattributed: the stream reports no call id and its item ids do not occur in the rollout"
      },
      "status": "item.completed: status_id 1/2 from item.status (Reported); item.started: 0 Unknown, basis 1 (reported in_progress)"
    },
    {
      "id": "codex.stream.turn_completed->prompt_turn.completed",
      "selector": {
        "type": "turn.completed"
      },
      "target": "agentic_cli/prompt_turn",
      "activity": "2 Turn completed",
      "usage": "usage -> scope 3 Prompt turn status 2 Final (rule codex.stream.turn_usage.v1)"
    },
    {
      "id": "codex.stream.fallback->source_record",
      "selector": "thread.started, turn.started",
      "target": "agentic_cli/source_record"
    }
  ],
  "block_kind_table": {
    "rule": "codex.block_type_to_kind.v1",
    "map": {
      "input_text": 1,
      "output_text": 1,
      "text": 1,
      "Text": 1,
      "input_image": 5
    },
    "default": 99
  }
}
