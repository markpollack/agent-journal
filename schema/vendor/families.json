{
 "kind": "agent-journal/occurrence-families",
 "version": "0.1",
 "reviewed": "2026-10-26 (ACCT-1)",
 "meaning": "ordered first-match rules per source profile over variant:path (Java regex, whole match) that assign each native occurrence to one execution family for the cross-CLI matrix; an occurrence no rule names is unassigned and reported as a gap of this table. A family is a reporting column, never a semantic classification: the disposition catalog decides what an occurrence is, this table only decides where it is counted",
 "families": [
  "content",
  "identities",
  "tools",
  "failures",
  "permissions",
  "children",
  "mcp",
  "usage",
  "economics",
  "provenance",
  "other"
 ],
 "family_meaning": {
  "content": "prompts, model text and reasoning, injected context, final answers and lifecycle members of a response",
  "identities": "response, call, turn, thread and session identifiers and the owner routing of a record",
  "tools": "tool requests, arguments, operations, results and their reported states",
  "failures": "errors, outcome statuses and failure reasons of runs, calls and model requests",
  "permissions": "permission modes, decisions, denials and their attribution",
  "children": "sub-agent and task lifecycle, child-run identity, counters and handbacks",
  "mcp": "MCP registration, server status, dispatcher and target identity and protocol metadata",
  "usage": "token usage, context windows and per-model usage figures",
  "economics": "monetary cost, billing quantities, credits, rate limits and quota",
  "provenance": "record identity, time, versions, settings, environment and request metadata",
  "other": "vendor members outside the ten families (durations, latencies, counters, mode flags, display hints, envelope containers)"
 },
 "profiles": {
  "claude_stream": [
   {
    "match": "\\(opaque:.*",
