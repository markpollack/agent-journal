<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.markpollack</groupId>
    <artifactId>agent-journal-parent</artifactId>
    <version>1.12.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Agent Journal Parent</name>
    <description>Execution ledger — Experiment/Run tracking for agent workflows</description>

    <licenses>
        <license>
            <name>Business Source License 1.1</name>
            <url>https://github.com/markpollack/agent-journal/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Mark Pollack</name>
        </developer>
    </developers>

    <url>https://github.com/markpollack/agent-journal</url>

    <scm>
        <url>https://github.com/markpollack/agent-journal</url>
        <connection>scm:git:git://github.com/markpollack/agent-journal.git</connection>
        <developerConnection>scm:git:git@github.com:markpollack/agent-journal.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- Dependency versions -->
        <claude-code-sdk.version>1.7.0</claude-code-sdk.version>
        <acp-core.version>0.16.1</acp-core.version>
        <!-- 2.21.4+ clears the 2026-06-23 jackson-databind cluster (CVE-2026-54512 /
             CVE-2026-54513, CVSS 8.1) that affects 2.19.0 -> 2.21.3. 2.21.6 is the head of
             that patch line and matches the agentworks-bom floor, so a consumer importing
             the BOM cannot resolve back to a vulnerable version.
             2.22.3 clears the 2026-09-22/23 denial-of-service cluster in jackson-core and
             jackson-databind (CVE-2026-89407, CVE-2026-89425, CVE-2026-91776,
             CVE-2026-91777), which affects 2.22.0 -> 2.22.2. -->
        <jackson.version>2.22.3</jackson.version>
        <!-- Jackson 3 (tools.jackson) arrives transitively through
             claude-code-sdk -> mcp -> mcp-json-jackson3 at 3.0.3, which is inside the
             affected range of the same CVE-2026-545xx cluster (fixed in 3.1.4) and of
             CVE-2026-29062. Converge it to the agentworks-bom floor.
             3.2.3 clears the same 2026-09-22/23 cluster on the Jackson 3 line. -->
        <jackson3.version>3.2.3</jackson3.version>
        <slf4j.version>2.0.18</slf4j.version>

        <!-- Test dependency versions -->
        <junit.version>5.14.4</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <logback.version>1.6.3</logback.version>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>

        <!-- java-guardrails gates (markpollack/java-guardrails v0.1.0); decisions in config/guardrails/decisions.md -->
        <!-- SpotBugs: spotbugs-maven-plugin 4.10.x requires Maven 3.8.9+; with an older wrapper the
             4.9.8.x plugin runs the current SpotBugs engine below. -->
        <spotbugs-maven-plugin.version>4.9.8.5</spotbugs-maven-plugin.version>
        <spotbugs.version>4.10.4</spotbugs.version>
        <spotbugs.includeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/spotbugs-include.xml</spotbugs.includeFilterFile>
        <!-- JaCoCo coverage floors: each module declares jacoco.minimum.line and jacoco.minimum.branch (measured from a clean run
             less 2 points, config/guardrails/decisions.md JACOCO_FLOORS); the parent default is full coverage, so a new module fails
             until it declares measured floors. -->
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <!-- surefire's argLine property, late-bound as @{...} by surefire; this build declares no argLine of its own -->
        <jacoco.propertyName>argLine</jacoco.propertyName>
        <!-- the coverage gate's skip follows -DskipTests; a pom that does not define skipTests declares it false -->
        <skipTests>false</skipTests>
        <jacoco.minimum.line>1.00</jacoco.minimum.line>
        <jacoco.minimum.branch>1.00</jacoco.minimum.branch>
    </properties>

    <modules>
        <module>journal-core</module>
        <module>journal-capture-tck</module>
        <module>journal-ocsf-writer</module>
        <module>claude-code-capture</module>
        <module>grok-cli-capture</module>
        <module>codex-cli-capture</module>
        <module>antigravity-cli-capture</module>
        <module>junie-cli-capture</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- JSON processing — Jackson BOM import (first, so it wins) aligns
                 every com.fasterxml.jackson artifact, including transitives -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Jackson 3 BOM (tools.jackson) — converges the Jackson 3 artifacts that
                 claude-code-sdk drags in transitively to the patched floor. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Test dependencies -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- The root LICENSE stays the single authoritative copy, but BSL 1.1 requires it
             to be displayed on every copy of the Licensed Work, so stage it into META-INF
             of each module's binary and source archive. -->
        <resources>
            <resource>
                <directory>${maven.multiModuleProjectDirectory}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <compilerArg>-parameters</compilerArg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
            </plugin>

            <!-- Stages the root LICENSE where the javadoc plugin picks it up, so the
                 javadoc archive carries the same terms as the binary and source jars. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <executions>
                    <execution>
                        <id>stage-javadoc-license</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javadoc-resources/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs gate: spotbugs:check fails verify on main sources, in every module and
                 on every JDK the build runs on (17 and 21; unlike the errorprone profile it does
                 not need JDK 21). The analysis reports findings up to rank 20; the include filter
                 config/spotbugs/spotbugs-include.xml keeps the ones that fail the build:
                 - every pattern of rank 9 or less (SpotBugs' "scariest" 1-4 and "scary" 5-9
                   bands). Rank, not confidence, is the gate: rank combines the pattern's severity
                   with its confidence, so it keeps the bugs and drops the long tail (exposed
                   arrays, missing static on inner classes, serialization advice) that a
                   confidence threshold alone would keep;
                 - a listed set of multithreaded-correctness patterns at any rank (inconsistent
                   synchronization, wait/notify and lock misuse, wrong lock objects), which
                   SpotBugs ranks 14 to 17 and the rank gate alone would miss.
                 One analysis and one filter, not two check executions: check forks the
                 spotbugs goal with the plugin-level configuration only, so a second check
                 execution with its own filter would analyse with the first one's settings and
                 then pass silently on a report that was never written.
                 threshold Medium (the default) also drops low-confidence findings; effort Max
                 runs the interprocedural detectors. find-sec-bugs is not used: on this code base
                 it adds no finding at rank 9 or less, and its findings below that are the
                 library's purpose (spawning the configured agent process, writing JSON-RPC
                 responses). A false positive is excluded narrowly (class, method, pattern), with
                 its reason, in config/spotbugs/spotbugs-exclude.xml. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <maxRank>20</maxRank>
                    <!-- a property so that measure can swap in an include-everything filter for the full distribution -->
                    <includeFilterFile>${spotbugs.includeFilterFile}</includeFilterFile>
                    <includeTests>false</includeTests>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/spotbugs-exclude.xml</excludeFilterFile>
                    <failOnError>true</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- JaCoCo code coverage. Each module's report (target/site/jacoco/index.html) and
                 gate count that module's own classes, exercised by that module's own tests:
                 acp-core code reached only from another module's tests is not counted, and the
                 JSON modules, which run acp-core's contract suite against their mapper, count
                 only their mapper classes. Nothing is excluded. The integration harness
                 (integration-testing/) is outside the Maven build and is not counted.

                 The gate (check, in verify) fails when a module's LINE or BRANCH covered ratio
                 falls below its floor. Every module declares jacoco.minimum.line and
                 jacoco.minimum.branch; the default below is full coverage, so a new module
                 fails until it declares measured floors. A floor is the coverage measured from a clean verify less a margin of
                 2 points, rounded down to a whole percent: enough for the run-to-run variation
                 of the concurrent tests (a branch or two), too little to lose a test class
                 unnoticed. Raise a floor when coverage rises; lower one only with a reason in
                 the commit. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- The property surefire's <argLine> reads, late-bound as @{name}; argLine
                                 unless the target names its own (the MCP SDK: surefireArgLine). -->
                            <propertyName>${jacoco.propertyName}</propertyName>
                        </configuration>
                    </execution>
                    <!-- In verify, after the integration tests (failsafe appends to the same
                         execution data) and before the gate, so the report shows what the
                         gate checks. -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- No gate without tests: with -DskipTests the check would read
                                 whatever execution data an earlier run left in target (a
                                 -Dtest run's partial coverage, for one) and fail the build. -->
                            <skip>${skipTests}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            OWASP dependency-check — the local CVE path. It is deliberately not wired into
            GitHub Actions: the NVD acquisition is slow, shared across the portfolio, and
            failed nightly for weeks without telling anyone anything about this repository.

            Complete inventory first, enforcement second:

              inventory (never fails, scans every module):
                ./mvnw -Powasp verify -DskipTests -Downed.cvss.threshold=11

              gate (fails on CVSS >= 7.0 in the shipped closure):
                ./mvnw -Powasp verify -DskipTests

            Add -DnvdAutoUpdate=false to reuse an already-prepared database. Scanner
            identity corrections live in owasp-suppressions.xml, one exact package URL at a
            time.
        -->
        <profile>
            <id>owasp</id>
            <properties>
                <owned.cvss.threshold>7.0</owned.cvss.threshold>
                <nvdAutoUpdate>true</nvdAutoUpdate>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.1.0</version>
                        <configuration>
                            <failBuildOnCVSS>${owned.cvss.threshold}</failBuildOnCVSS>
                            <autoUpdate>${nvdAutoUpdate}</autoUpdate>
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/owasp-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!--
                      Inline inherited metadata into every published module pom.

                      Without this, a child module publishes a pom carrying only <parent> and its
                      own coordinates. The licence, description, url, scm and developers are all
                      declared once in the parent and are reachable only by resolving the parent
                      chain. Maven does that; licence scanners, SBOM generators and dependency
                      audits frequently do not, and read the artifact's own pom alone.

                      Measured on 2026-08-30: journal-core 1.10.0's published pom declares NO
                      licence, while agent-journal-parent 1.10.0 declares Business Source License
                      1.1. Nothing was unlicensed - the jar carries META-INF/LICENSE and the parent
                      declares it - but an acquirer's automated crawl read the estate as partly
                      unlicensed, because the surface tools read had nothing on it.

                      agent-client already published correctly for exactly this reason; it had
                      flatten and these modules did not.
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.7.3</version>
                        <configuration>
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten.clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <failOnError>false</failOnError>
                            <quiet>true</quiet>
                            <javadocDirectory>${project.build.directory}/javadoc-resources</javadocDirectory>
                            <docfilessubdirs>true</docfilessubdirs>
                            <bottom><![CDATA[Agent Journal is licensed under the project-specific Business Source License terms in the repository root LICENSE file.]]></bottom>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
