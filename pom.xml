<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.markpollack</groupId>
    <artifactId>agent-journal-parent</artifactId>
    <version>1.9.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Agent Journal Parent</name>
    <description>Execution ledger — Experiment/Run tracking for agent workflows</description>

    <licenses>
        <license>
            <name>Business Source License 1.1</name>
            <url>https://github.com/markpollack/agent-journal/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Mark Pollack</name>
        </developer>
    </developers>

    <url>https://github.com/markpollack/agent-journal</url>

    <scm>
        <url>https://github.com/markpollack/agent-journal</url>
        <connection>scm:git:git://github.com/markpollack/agent-journal.git</connection>
        <developerConnection>scm:git:git@github.com:markpollack/agent-journal.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- Dependency versions -->
        <claude-code-sdk.version>1.5.0</claude-code-sdk.version>
        <gemini-cli-sdk.version>0.22.0</gemini-cli-sdk.version>
        <!-- 2.21.4+ clears the 2026-06-23 jackson-databind cluster (CVE-2026-54512 /
             CVE-2026-54513, CVSS 8.1) that affects 2.19.0 -> 2.21.3. 2.21.6 is the head of
             that patch line and matches the agentworks-bom floor, so a consumer importing
             the BOM cannot resolve back to a vulnerable version. -->
        <jackson.version>2.21.6</jackson.version>
        <!-- Jackson 3 (tools.jackson) arrives transitively through
             claude-code-sdk -> mcp -> mcp-json-jackson3 at 3.0.3, which is inside the
             affected range of the same CVE-2026-545xx cluster (fixed in 3.1.4) and of
             CVE-2026-29062. Converge it to the agentworks-bom floor. -->
        <jackson3.version>3.1.6</jackson3.version>
        <slf4j.version>2.0.17</slf4j.version>

        <!-- Test dependency versions -->
        <junit.version>5.11.3</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <logback.version>1.5.12</logback.version>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.2</cyclonedx-maven-plugin.version>
    </properties>

    <modules>
        <module>journal-core</module>
        <module>claude-code-capture</module>
        <module>gemini-cli-capture</module>
        <module>grok-cli-capture</module>
        <module>codex-cli-capture</module>
        <module>antigravity-cli-capture</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- JSON processing — Jackson BOM import (first, so it wins) aligns
                 every com.fasterxml.jackson artifact, including transitives -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Jackson 3 BOM (tools.jackson) — converges the Jackson 3 artifacts that
                 claude-code-sdk drags in transitively to the patched floor. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Test dependencies -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- The root LICENSE stays the single authoritative copy, but BSL 1.1 requires it
             to be displayed on every copy of the Licensed Work, so stage it into META-INF
             of each module's binary and source archive. -->
        <resources>
            <resource>
                <directory>${maven.multiModuleProjectDirectory}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <compilerArg>-parameters</compilerArg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
            </plugin>

            <!-- Stages the root LICENSE where the javadoc plugin picks it up, so the
                 javadoc archive carries the same terms as the binary and source jars. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <executions>
                    <execution>
                        <id>stage-javadoc-license</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javadoc-resources/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                One schema-1.6 JSON aggregate SBOM for the whole reactor. The execution is
                root-only (inherited=false) so child modules neither generate nor attach
                module BOMs; the single aggregate rides along with the deployed parent under
                the `cyclonedx` classifier. It runs at verify because the aggregate goal
                requires online mode.
            -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <projectType>library</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>true</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeSystemScope>true</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                    <includeLicenseText>false</includeLicenseText>
                    <outputReactorProjects>false</outputReactorProjects>
                    <!-- Central Publishing replaces Maven's standard deploy path. -->
                    <skipNotDeployed>false</skipNotDeployed>
                    <outputFormat>json</outputFormat>
                    <outputName>agent-journal-bom</outputName>
                    <classifier>cyclonedx</classifier>
                </configuration>
                <executions>
                    <execution>
                        <id>aggregate-cyclonedx-sbom</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            OWASP dependency-check — the local CVE path. It is deliberately not wired into
            GitHub Actions: the NVD acquisition is slow, shared across the portfolio, and
            failed nightly for weeks without telling anyone anything about this repository.

            Complete inventory first, enforcement second:

              inventory (never fails, scans every module):
                ./mvnw -Powasp verify -DskipTests -Downed.cvss.threshold=11

              gate (fails on CVSS >= 7.0 in the shipped closure):
                ./mvnw -Powasp verify -DskipTests

            Add -DnvdAutoUpdate=false to reuse an already-prepared database. Scanner
            identity corrections live in owasp-suppressions.xml, one exact package URL at a
            time.
        -->
        <profile>
            <id>owasp</id>
            <properties>
                <owned.cvss.threshold>7.0</owned.cvss.threshold>
                <nvdAutoUpdate>true</nvdAutoUpdate>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.1.0</version>
                        <configuration>
                            <failBuildOnCVSS>${owned.cvss.threshold}</failBuildOnCVSS>
                            <autoUpdate>${nvdAutoUpdate}</autoUpdate>
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/owasp-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <failOnError>false</failOnError>
                            <quiet>true</quiet>
                            <javadocDirectory>${project.build.directory}/javadoc-resources</javadocDirectory>
                            <docfilessubdirs>true</docfilessubdirs>
                            <bottom><![CDATA[Agent Journal is licensed under the project-specific Business Source License terms in the repository root LICENSE file.]]></bottom>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
