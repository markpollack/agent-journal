<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        Identity correction, not a vulnerability waiver.

        dependency-check derives `cpe:2.3:a:github:cli` for
        pkg:maven/io.github.markpollack/gemini-cli-sdk because the coordinates contain the
        tokens "github" and "cli". That CPE belongs to the GitHub CLI (`gh`), a Go program
        published by GitHub, and drags in CVE-2024-52308 (9.6) — remote code execution when
        `gh` connects to a malicious Codespace SSH server. gemini-cli-sdk is an unrelated
        Java client library and ships none of that code.

        The suppression is bound to this one package URL and this one mis-assigned CPE, so
        a genuine future advisory against gemini-cli-sdk still fails the gate, and no other
        component inherits the exemption.
    -->
    <suppress>
        <notes><![CDATA[
            gemini-cli-sdk is not the GitHub CLI. Suppresses only the mis-assigned
            cpe:/a:github:cli identity for this exact artifact.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.github\.markpollack/gemini-cli-sdk@.*$</packageUrl>
        <cpe>cpe:/a:github:cli</cpe>
    </suppress>

</suppressions>
