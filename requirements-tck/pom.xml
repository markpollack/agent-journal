<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Journal's independent requirements TCK. It is not a module of Journal's reactor and is never installed, deployed
        or released; nothing depends on it. It evaluates Journal's RFC 2119 rules and EARS criteria
        (src/test/resources/requirements/) with Agent Judge's requirement readers, against a Journal checkout that has
        already been built: the oracle on Journal's committed fixtures, the surefire results of Journal's modules and the
        committed upstream-validation summaries. Keeping Agent Judge here means Journal's own build names no Judge artifact,
        so Journal does not close the cycle Client -> Journal -> Judge -> Client.

        Run from the repository root, after Journal's build:
            ./mvnw clean verify
            ./mvnw -f requirements-tck/pom.xml clean verify
        Another checkout: -Djournal.root=<path>. Journal and Agent Judge resolve as local snapshots (~/.m2).
    -->
    <groupId>io.github.markpollack</groupId>
    <artifactId>journal-requirements-tck</artifactId>
    <version>0-SNAPSHOT</version>
    <name>Agent Journal requirements TCK</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Agent Judge builds for Java 21 -->
        <maven.compiler.release>21</maven.compiler.release>
        <journal.version>2.0.0-SNAPSHOT</journal.version>
        <agent-judge.version>1.1.0-SNAPSHOT</agent-judge.version>
        <jackson.version>2.22.3</jackson.version>
        <junit.version>5.14.4</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <journal.root>${project.basedir}/..</journal.root>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>journal-capture-tck</artifactId>
            <version>${journal.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>journal-ocsf-writer</artifactId>
            <version>${journal.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-judge-ai-core</artifactId>
            <version>${agent-judge.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- Journal's committed oracle fixtures, read in place from the checkout under test -->
            <testResource>
                <directory>${journal.root}/journal-capture-tck/src/test/resources</directory>
                <includes>
                    <include>ocsf/fixtures/**</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <journal.root>${journal.root}</journal.root>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- The accounting runs after this TCK's unit tests: RequirementsAccountingIT reads the requirements reporter's
                 statuses, the surefire results of Journal's modules and of this TCK, and the committed upstream-validation
                 summaries, and fails on a missing instrument or a failed obligation. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <journal.root>${journal.root}</journal.root>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
