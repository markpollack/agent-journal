<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.markpollack</groupId>
        <artifactId>agent-journal-parent</artifactId>
        <version>1.12.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>journal-capture-tck</artifactId>
    <packaging>jar</packaging>

    <name>Journal Capture TCK</name>
    <description>Test kit for the capture admission criteria: compares what a vendor's own session files
        contain with what Journal recorded, and checks the other criteria on real captures</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Mutation testing (PIT) over the independent OCSF oracle and reader: a measurement, not a gate on every
            change. Run: ./mvnw -Ppit -pl journal-capture-tck test   (-Dpit.mutators=STRONGER for the larger set)
            Scope: the checking path only. The non-production repackager, the CLI entry point and the data records
            are excluded; the threshold applies within the profile only.
        -->
        <profile>
            <id>pit</id>
            <properties>
                <pitest-maven.version>1.30.0</pitest-maven.version>
                <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
                <pit.mutators>DEFAULTS</pit.mutators>
                <pit.threads>4</pit.threads>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>pit</id>
                                <phase>test</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <mutationThreshold>70</mutationThreshold>
                            <targetClasses>
                                <param>io.github.markpollack.journal.tck.ocsf.OcsfOracle</param>
                                <param>io.github.markpollack.journal.tck.ocsf.PackageReader</param>
                                <param>io.github.markpollack.journal.tck.ocsf.AnalysisViews</param>
                                <param>io.github.markpollack.journal.tck.ocsf.SchemaCatalog</param>
                                <param>io.github.markpollack.journal.tck.ocsf.NativeArtifact</param>
                                <param>io.github.markpollack.journal.tck.ocsf.Reconstruction</param>
                                <param>io.github.markpollack.journal.tck.ocsf.ClaudeStreamProfile</param>
                                <param>io.github.markpollack.journal.tck.ocsf.CodexRolloutProfile</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.markpollack.journal.tck.ocsf.*Test</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>io.github.markpollack.journal.tck.ocsf.OcsfEvidenceDriverTest</param>
                            </excludedTestClasses>
                            <mutators><mutator>${pit.mutators}</mutator></mutators>
                            <threads>${pit.threads}</threads>
                            <timeoutConstant>8000</timeoutConstant>
                            <timeoutFactor>2.0</timeoutFactor>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats><param>HTML</param><param>XML</param><param>CSV</param></outputFormats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
