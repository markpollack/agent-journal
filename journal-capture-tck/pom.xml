<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.markpollack</groupId>
        <artifactId>agent-journal-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>journal-capture-tck</artifactId>
    <packaging>jar</packaging>

    <name>Journal Capture TCK</name>
    <description>Test kit for the capture admission criteria: compares what a vendor's own session files
        contain with what Journal recorded, and checks the other criteria on real captures</description>

    <properties>
        <!-- java-guardrails PMD ratchet: today's count (2026-10-31, after the 1.x verifier and Venn left this module; 243 on 2026-10-21), lowered as fixes land; never raised -->
        <pmd.ratchet>202</pmd.ratchet>
        <!-- java-guardrails JaCoCo floors: measured 2026-10-21 less 2 points (config/guardrails/decisions.md) -->
        <jacoco.minimum.line>0.85</jacoco.minimum.line>
        <jacoco.minimum.branch>0.74</jacoco.minimum.branch>
        <!--
            Agent Judge is a test-only dependency: its RFC 2119 / EARS readers and native requirement types load the
            requirement documents under src/test/resources/requirements/ (see the tck.requirements tests). It never
            enters the writer or capture path. Its parent builds for Java 21, so the tests of this module run on a
            21+ JDK (as CI does) while the module itself still compiles at the project's release level.

            0.19.0-SNAPSHOT (adopted 2026-10-21 for dogfooding, by decision): carries the corrected readers from
            markpollack/agent-judge 5277e18770534941933875e26dde5225a4eb8850 (full RFC statement in the native
            specification, explicit `Applies when:` applicability, strict loading that refuses malformed entries).
            Resolved from the local Maven installation on the same machine or from the parent's central-snapshots
            repository (published build 0.19.0-20261021.173258-1); a SNAPSHOT coordinate is not a build identity,
            so the consumed artifact's hash is recorded with each result in the steward evidence, never assumed.
        -->
        <agent-judge.version>0.19.0-SNAPSHOT</agent-judge.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- validates protocol objects a package carries (McpProtocol: the pinned MCP definitions declared in the event
             file, draft 2020-12) and, in tests, the coverage bookkeeping documents against their JSON Schemas. Part of
             the independent reader and checks; never on the writer's or the capture's path -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.7</version>
        </dependency>
        <!-- json-schema-validator depends on jackson-dataformat-yaml at its own Jackson version (2.18.3 for 1.5.7), which
             is inside the 2026-09-22/23 denial-of-service range; declared here at the BOM's version so a standalone
             consumer of this artifact resolves the patched line (scripts/check-consumer-resolution.py). The TCK's own
             code never reads YAML except in the gated FoundationFieldsTest, which re-derives the foundation field
             inventory from the pinned OTel GenAI semantic-convention files -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-judge-ai-core</artifactId>
            <version>${agent-judge.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Mutation testing (PIT) over the independent OCSF oracle and reader: a measurement, not a gate on every
            change. Run: ./mvnw -Ppit -pl journal-capture-tck test   (-Dpit.mutators=STRONGER for the larger set)
            Scope: the checking path only. The non-production repackager, the CLI entry point and the data records
            are excluded; the threshold applies within the profile only.
        -->
        <profile>
            <id>pit</id>
            <properties>
                <pitest-maven.version>1.30.0</pitest-maven.version>
                <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
                <pit.mutators>DEFAULTS</pit.mutators>
                <pit.threads>4</pit.threads>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>pit</id>
                                <phase>test</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <mutationThreshold>70</mutationThreshold>
                            <targetClasses>
                                <param>io.github.markpollack.journal.tck.ocsf.OcsfOracle</param>
                                <param>io.github.markpollack.journal.tck.ocsf.PackageReader</param>
                                <param>io.github.markpollack.journal.tck.ocsf.DeclaredFile</param>
                                <param>io.github.markpollack.journal.tck.ocsf.AnalysisViews</param>
                                <param>io.github.markpollack.journal.tck.ocsf.SchemaCatalog</param>
                                <param>io.github.markpollack.journal.tck.ocsf.NativeArtifact</param>
                                <param>io.github.markpollack.journal.tck.ocsf.Reconstruction</param>
                                <param>io.github.markpollack.journal.tck.ocsf.ClaudeStreamProfile</param>
                                <param>io.github.markpollack.journal.tck.ocsf.CodexRolloutProfile</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.markpollack.journal.tck.ocsf.*Test</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>io.github.markpollack.journal.tck.ocsf.OcsfEvidenceDriverTest</param>
                            </excludedTestClasses>
                            <mutators><mutator>${pit.mutators}</mutator></mutators>
                            <threads>${pit.threads}</threads>
                            <timeoutConstant>8000</timeoutConstant>
                            <timeoutFactor>2.0</timeoutFactor>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats><param>HTML</param><param>XML</param><param>CSV</param></outputFormats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
