{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:agent-journal:foundation-parity:0.1",
 "title": "Tier 1 parity ledger: one facet per group of pinned foundation fields",
 "type": "object",
 "required": [
  "kind",
  "version",
  "reviewed",
  "meaning",
  "inventory",
  "routes",
  "vocabularies",
  "facets"
 ],
 "properties": {
  "kind": {
   "const": "agent-journal/foundation-parity"
  },
  "version": {
   "const": "0.1"
  },
  "reviewed": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "meaning": {
   "type": "string",
   "minLength": 1
  },
  "inventory": {
   "const": "foundation-fields.json"
  },
  "routes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "vocabularies": {
   "type": "object",
   "required": [
    "tier",
    "definition",
    "state",
    "relation",
    "route"
   ]
  },
  "facets": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "group",
     "summary",
     "fields",
     "concepts",
     "proposal",
     "destinations",
     "relation",
     "differences",
     "tier",
     "tier_reason",
     "definition",
     "state",
     "routes",
     "route_evidence",
     "evidence",
     "action"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
     },
     "group": {
      "type": "string",
      "minLength": 1
     },
     "summary": {
      "type": "string",
      "minLength": 1
     },
     "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "concepts": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "proposal": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "required": [
         "id",
         "question"
        ],
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "question": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      ]
     },
     "destinations": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "relation": {
      "enum": [
       "equivalent",
       "adapted",
       "finer",
       "coarser",
       "different",
       "none"
      ]
     },
     "differences": {
      "type": "string",
      "minLength": 1
     },
     "tier": {
      "enum": [
       "1",
       "2",
       "3",
       "out_of_scope_proposed"
      ]
     },
     "tier_reason": {
      "type": "string",
      "minLength": 1
     },
     "definition": {
      "enum": [
       "defined",
       "partial",
       "missing",
       "unresolved"
      ]
     },
     "state": {
      "enum": [
       "covered",
       "partial",
       "not_exercised",
       "source_limited",
       "derivable",
       "mapper_missing",
       "definition_missing",
       "definition_unresolved",
       "excluded_proposed",
       "tier3_consumer"
      ]
     },
     "routes": {
      "type": "object",
      "additionalProperties": {
       "enum": [
        "mapped",
        "unexercised",
        "retained_only",
        "source_limited",
        "not_applicable"
       ]
      }
     },
     "route_evidence": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "action": {
      "type": "string",
      "minLength": 1
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
