{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:agent-journal:semantic-claim:0.1",
 "title": "Semantic claim of a mapping-catalog concept (catalog concepts[].claims[])",
 "description": "Shape only. Java (SemanticClaimTest) checks the digest, the links to examples, evidence, destinations and checks, and the approval's decision; a valid claim says nothing about whether its interpretation is right.",
 "type": "object",
 "required": [
  "id",
  "revision",
  "digest",
  "statement",
  "applicability",
  "destinations",
  "normative_examples",
  "evidence",
  "checks",
  "approval"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
  },
  "revision": {
   "type": "integer",
   "minimum": 1
  },
  "digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "digest_boundary": {
   "description": "Absent or 1: the digest covers statement, applicability (with version pins), semantics, destinations and normative examples. 2: the digest covers the meaning only (statement, semantics, destinations, normative examples with the claim's binding identifiers replaced by role tokens); routes, contract and extension pins and the relevant definitions and rules are the binding.",
   "enum": [
    1,
    2
   ]
  },
  "statement": {
   "type": "string",
   "minLength": 40
  },
  "applicability": {
   "type": "object",
   "required": [
    "routes"
   ],
   "additionalProperties": false,
   "properties": {
    "routes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "contracts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "extension": {
     "type": "string"
    },
    "condition": {
     "type": "string"
    }
   }
  },
  "semantics": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "identity": {
     "type": "string"
    },
    "owner_scope": {
     "type": "string"
    },
    "grouping": {
     "type": "string"
    },
    "order": {
     "type": "string"
    },
    "finality": {
     "type": "string"
    },
    "absence_default": {
     "type": "string"
    }
   }
  },
  "destinations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "normative_examples": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "evidence": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "checks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^(oracle:[A-Za-z]+Profile/[a-z_.]+|junit:[A-Za-z]+#[A-Za-z0-9]+)$"
   }
  },
  "replaces": {
   "type": "string"
  },
  "notes": {
   "type": "string"
  },
  "approval": {
   "type": "object",
   "required": [
    "status"
   ],
   "properties": {
    "status": {
     "enum": [
      "proposed",
      "approved",
      "superseded",
      "rejected"
     ]
    },
    "revision": {
     "type": "integer"
    },
    "digest": {
     "type": "string"
    },
    "approver": {
     "type": "string"
    },
    "decision": {
     "type": "string"
    },
    "basis": {
     "type": "string"
    },
    "superseded_by": {
     "type": "string"
    },
    "previous": {
     "description": "The earlier revision of this claim that a recorded decision approved, and what changed since; evidence for the reviewer binding this revision, never an approval of it (outside the digest).",
     "type": "object",
     "required": [
      "revision",
      "digest",
      "decision",
      "delta"
     ],
     "additionalProperties": false,
     "properties": {
      "revision": {
       "type": "integer",
       "minimum": 1
      },
      "digest": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "decision": {
       "type": "string"
      },
      "delta": {
       "type": "string"
      }
     }
    },
    "binding": {
     "description": "Boundary 2: the binding the approval was given for; a later binding with the same relevant_digest and no new route carries the approval (pins changed only), a changed relevant_digest refuses it, an added route awaits binding review.",
     "type": "object",
     "required": [
      "relevant_digest",
      "routes",
      "digest"
     ],
     "additionalProperties": false,
     "properties": {
      "relevant_digest": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "routes": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string"
       }
      },
      "digest": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}$"
      }
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "const": "approved"
       }
      }
     },
     "then": {
      "required": [
       "revision",
       "digest",
       "approver",
       "decision"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "superseded"
       }
      }
     },
     "then": {
      "required": [
       "superseded_by"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "proposed"
       }
      }
     },
     "then": {
      "not": {
       "anyOf": [
        {
         "required": [
          "decision"
         ]
        },
        {
         "required": [
          "approver"
         ]
        }
       ]
      }
     }
    }
   ]
  },
  "binding": {
   "description": "Boundary 2: what the meaning is bound to. rules names the contract rules (or table:<member> contract tables) the meaning depends on; relevant_digest covers the extension definitions of the destinations and those rules with binding identifiers replaced; digest covers applicability, relevant_digest and the bytes of each normative example.",
   "type": "object",
   "required": [
    "rules",
    "relevant_digest",
    "digest"
   ],
   "additionalProperties": false,
   "properties": {
    "rules": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "relevant_digest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "digest_boundary": {
      "const": 2
     }
    },
    "required": [
     "digest_boundary"
    ]
   },
   "then": {
    "required": [
     "binding"
    ]
   }
  }
 ]
}
