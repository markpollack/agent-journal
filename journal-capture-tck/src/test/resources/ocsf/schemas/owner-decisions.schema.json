{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:agent-journal:owner-decisions:0.1",
 "title": "Public-safe identities of the Project Owner's semantic decisions",
 "type": "object",
 "required": [
  "kind",
  "format_version",
  "meaning",
  "decisions"
 ],
 "properties": {
  "kind": {
   "const": "agent-journal/owner-decisions"
  },
  "format_version": {
   "const": "0.1"
  },
  "meaning": {
   "type": "string"
  },
  "decisions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "date",
     "approver",
     "summary",
     "record",
     "approves"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^OWNER-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9-]+$"
     },
     "date": {
      "type": "string",
      "format": "date"
     },
     "approver": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     },
     "record": {
      "type": "string"
     },
     "binding": {
      "type": "string"
     },
     "approves": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "claim",
        "revision",
        "digest"
       ],
       "additionalProperties": false,
       "properties": {
        "claim": {
         "type": "string"
        },
        "revision": {
         "type": "integer",
         "minimum": 1
        },
        "digest": {
         "type": "string",
         "pattern": "^sha256:[0-9a-f]{64}$"
        }
       }
      }
     }
    }
   }
  }
 }
}
