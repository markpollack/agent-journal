{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:agent-journal:coverage-references:0.1",
 "title": "Shared pinned evidence references (ocsf/mapping-catalog/references.json)",
 "type": "object",
 "required": [
  "kind",
  "format_version",
  "references"
 ],
 "properties": {
  "kind": {
   "const": "agent-journal/coverage-references"
  },
  "format_version": {
   "const": "0.1"
  },
  "meaning": {
   "type": "string"
  },
  "references": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "source",
     "evidence_kind"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "revision": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "blob": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
     },
     "symbol": {
      "type": "string"
     },
     "locator": {
      "type": "string"
     },
     "evidence_kind": {
      "enum": [
       "specification",
       "source_inspection",
       "synthetic",
       "replay",
       "live",
       "persisted_readback",
       "publisher_normalized"
      ],
      "description": "What the reference is: specification (a definition), source_inspection (pinned source, schema, type or serializer), synthetic, replay (of a recording), live (a recording of a live run), persisted_readback, or publisher_normalized (a third party's normalized corpus of agent sessions: neither native CLI output nor a live run; its rows do not establish an original native identity, mapping or field)"
     },
     "note": {
      "type": "string"
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "evidence_kind": {
         "const": "source_inspection"
        }
       }
      },
      "then": {
       "required": [
        "revision",
        "path"
       ]
      }
     },
     {
      "if": {
       "properties": {
        "evidence_kind": {
         "const": "publisher_normalized"
        }
       }
      },
      "then": {
       "required": [
        "revision",
        "path",
        "note"
       ]
      }
     }
    ]
   }
  }
 }
}
