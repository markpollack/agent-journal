    }
  ],
  "counterexamples": [
    {
      "id": "per-turn-scope",
      "record": 9,
      "class": "prompt_turn",
      "activity_id": 2,
      "values": {"/usage_observations/0/scope_id": 3},
      "why": "Turn completion is when the emitter writes the thread's cumulative total; it is not evidence that the measurement covers only this turn. The components are equal under both readings; the scope is the meaning."
