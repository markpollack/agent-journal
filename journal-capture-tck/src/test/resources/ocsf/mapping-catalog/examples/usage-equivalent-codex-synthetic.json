    "artifact": "stream.jsonl",
    "lines": [
      "{\"type\":\"thread.started\",\"thread_id\":\"00000000-0000-4000-8000-00000000fa12\"}",
      "{\"type\":\"turn.started\"}",
      "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":1000,\"cached_input_tokens\":800,\"cache_write_input_tokens\":0,\"output_tokens\":50,\"reasoning_output_tokens\":0}}"
