{
  "kind": "agent-journal/semantic-example",
  "format_version": "0.1",
  "id": "codex-usage-default-zero-synthetic",
  "concept": "usage-scope-finality-and-repeats",
  "description": "LABELLED SYNTHETIC, source-grounded: a turn.completed whose components are all zero. The pinned emitter writes Usage::default() (all zeros) when no ThreadTokenUsageUpdated arrived (the vendor test turn_completion_recovers_final_message_from_turn_items emits exactly that), so a measured zero is not established: the components are preserved and the measurement status is Possibly default. Component measurement (extension 0.8.0): every component is Possibly default; 0 - 0 = 0 is only the uncached component's conditional value, and the canonical uncached tranche stays absent.",
  "authored_from": [
    "codex-exec-0.160.1-emitter-usage",
    "codex-exec-0.160.1-emitter-tests",
    "codex-api-0.160.1-responses-usage-defaults",
    "codex-exec-0.160.1-types",
    "codex-api-0.160.1-completed-usage-optional",
    "codex-core-0.160.1-record-token-usage",
    "agentic-cli-0.8.0-usage-uncertainty"
  ],
  "native": {
    "evidence_kind": "synthetic",
    "profile": "codex_stream",
    "compatibility_entry": "codex-cli/exec-json-stream/0.160.1",
    "run_spec_fixture": "syn-codex-exec-families-0.160.1",
    "artifact": "stream.jsonl",
    "lines": [
      "{\"type\":\"thread.started\",\"thread_id\":\"00000000-0000-4000-8000-00000000fa01\"}",
      "{\"type\":\"turn.started\"}",
      "{\"type\":\"item.completed\",\"item\":{\"id\":\"item_0\",\"type\":\"agent_message\",\"text\":\"SYNTHETIC: final answer\"}}",
      "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":0,\"cached_input_tokens\":0,\"cache_write_input_tokens\":0,\"output_tokens\":0,\"reasoning_output_tokens\":0}}"
    ]
  },
  "expected": [
    {
      "record": 4,
      "class": "prompt_turn",
      "activity_id": 2,
      "values": {
        "/usage_observations/0/scope_id": 5,
        "/usage_observations/0/measurement_status_id": 2,
        "/usage_observations/0/output_tokens": 0,
        "/usage_observations/0/components/0/component_basis_id": 3,
        "/usage_observations/0/components/0/measurement_status_id": 3,
        "/usage_observations/0/components/1/measurement_status_id": 2,
        "/usage_observations/0/components/2/measurement_status_id": 2,
        "/usage_observations/0/components/3/measurement_status_id": 2,
        "/usage_observations/0/components/4/measurement_status_id": 2,
        "/usage_observations/0/components/0/conditional_value": 0
      },
      "absent": [
        "/usage_observations/0/uncached_input_tokens"
      ]
    }
  ],
  "counterexamples": [
    {
      "id": "measured-zero",
      "record": 4,
      "class": "prompt_turn",
      "activity_id": 2,
      "values": {
        "/usage_observations/0/measurement_status_id": 1
      },
      "why": "All zeros is also the emitter's default without an update; claiming a measurement would turn missing usage into a zero."
    },
    {
      "id": "components-measured",
      "record": 4,
      "class": "prompt_turn",
      "activity_id": 2,
      "values": {
        "/usage_observations/0/components/3/measurement_status_id": 1
      },
      "why": "With every member zero no update is established, so no component, not even a required one, is a measured zero."
    },
    {
      "id": "dropped-components",
      "record": 4,
      "class": "prompt_turn",
      "activity_id": 2,
      "values": {
        "/usage_observations/0/output_tokens": null
      },
      "why": "The source reported the components; the ambiguity is stated, the values are not discarded."
    },
    {
      "id": "conditional-as-canonical",
      "record": 4,
      "class": "prompt_turn",
      "activity_id": 2,
      "values": {
        "/usage_observations/0/uncached_input_tokens": 0
      },
      "why": "A formula result that holds only under the named assumptions is the component's conditional value, never the canonical uncached tranche: a consumer summing uncached_input_tokens would otherwise mix an exact quantity with an assumption."
    }
  ]
}
