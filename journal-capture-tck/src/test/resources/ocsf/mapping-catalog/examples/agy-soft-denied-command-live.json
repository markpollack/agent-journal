        "/identity_basis_id": 99,
        "/reported_state": "DONE",
        "/status_id": 0,
        "/status_basis_id": 3
      },
      "absent": [
        "/tool_result",
        "/permission_decision"
      ]
    },
    {
      "record": 9,
