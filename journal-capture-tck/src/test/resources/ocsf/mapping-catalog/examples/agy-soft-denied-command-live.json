  "id": "agy-soft-denied-command-live",
  "concept": "tool-result-error-and-status",
  "description": "SANITIZED LIVE RECORDING (Antigravity CLI 1.4.6, default request-review mode): headless mode soft-denied the command permission. The run_command step (index 4) became ACTIVE, then DONE with neither output nor error: DONE is a lifecycle state, so the outcome is not derivable, and the call is not a success. The result reports SUCCESS for the run and one denied_actions entry {action: command, display_name: RunCommand}, which names a permission category, never a step: one Denied decision at Run scope, Unattributed, with no candidates.",
  "authored_from": [
    "agy-headless-docs-2026-10-23",
    "agy-live-1.4.6-recordings",
    "agy-permissions-docs-2026-10-23",
    "agy-changelog-1.4.6"
  ],
  "native": {
    "evidence_kind": "live",
    "profile": "agy_stream",
    "compatibility_entry": "antigravity-cli/stream-json/1.4.6-stdout",
    "fixture": "antigravity-live-1.4.6-denial",
    "artifact": "stream.jsonl",
    "sha256": "2ba182de66186317e245e71c18351a46f4c0b0a6bd58eaa6dba0114d24110894"
  },
  "expected": [
    {
