  "counterexamples": [
    {
      "id": "denied-command-as-success",
      "record": 8,
      "class": "tool_call",
      "activity_id": 2,
      "values": {
        "/status_id": 1
      },
      "why": "DONE is a lifecycle state; the command was soft-denied and never ran, so no success is established."
    },
    {
      "id": "denial-attributed-to-the-command-step",
      "record": 9,
      "class": "prompt_turn",
      "activity_id": 2,
      "values": {
        "/permission_decisions/0/attribution/candidates": [
          "4"
        ]
      },
      "why": "The entry names a permission category and a display name, never a step; linking it to step 4 by name or position would invent an association."
    },
    {
      "id": "denial-on-the-tool-call",
      "record": 8,
      "class": "tool_call",
      "activity_id": 2,
      "values": {
        "/permission_decision/decision_id": 2
      },
      "why": "The run-scope denial is reported on the result record; the step reports no decision."
