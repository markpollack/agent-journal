{
  "kind": "agent-journal/semantic-example",
  "format_version": "0.1",
  "id": "codex-mcp-tool-call-live",
  "concept": "tool-request-identity-and-arguments",
  "description": "A Codex CLI 0.160.1 MCP tool call (live recording, local deterministic MCP server fnd1). item.started reports a started invocation (activity 4), not the model's original request: tool_name and tool_namespace are the reported item.tool and item.server, the family is the item type, the arguments are the invocation's exactly, and the kind is 99 Other because no reviewed binding of server fnd1 exists. item.completed is the result under the same stream-local id.",
  "authored_from": [
    "codex-exec-0.160.1-emitter-items",
    "codex-exec-0.160.1-types"
  ],
  "native": {
    "evidence_kind": "live",
    "profile": "codex_stream",
    "compatibility_entry": "codex-cli/exec-json-stream/0.160.1",
    "fixture": "codex-live-0.160.1-mcp",
    "artifact": "stream.jsonl",
    "sha256": "2d69d5f7a223f888700474bca9edb1f952574f04acd408fc71bc174986038ffa"
  },
  "expected": [
    {
      "record": 4,
      "class": "tool_call",
      "activity_id": 4,
      "values": {
        "/tool_call_uid": "item_1",
        "/identity_basis_id": 2,
        "/tool_name": "echo_record",
        "/tool_namespace": "fnd1",
        "/tool_kind_id": 99,
        "/arguments": {
          "text": "fnd-1",
          "n": 7
        },
        "/reported_state": "in_progress",
        "/tool_family": "mcp_tool_call"
      },
      "absent": [
        "/response_uid",
        "/tool_result"
      ]
    },
    {
      "record": 5,
      "class": "tool_call",
      "activity_id": 2,
      "values": {
        "/tool_call_uid": "item_1",
        "/identity_basis_id": 2,
        "/status_id": 1,
        "/status_basis_id": 1,
        "/tool_result/data": [
          {
            "type": "text",
            "text": "{\"echo\": \"fnd-1\", \"n\": 7, \"ok\": true}"
          }
        ],
        "/tool_result/structured_result": {
          "echo": "fnd-1",
          "n": 7,
          "ok": true
        },
        "/tool_result/error_reported": false,
        "/reported_state": "completed",
        "/tool_family": "mcp_tool_call"
      }
    },
    {
      "record": 7,
      "class": "tool_call",
      "activity_id": 2,
      "values": {
        "/tool_call_uid": "item_2",
        "/status_id": 2,
        "/tool_result/data": [
          {
            "type": "text",
            "text": "always_fails: deliberate test failure"
          }
        ],
        "/tool_result/error_reported": true,
        "/reported_state": "failed"
      },
      "absent": [
        "/tool_result/structured_result"
      ]
    }
  ],
  "absent_events": [
    {
      "record": 4,
      "class": "tool_call",
      "activity_id": 1,
      "why": "the stream reports the invocation as started; the model request that caused it is not observed on this route"
    }
  ],
  "counterexamples": [
    {
      "id": "model-facing-call-id",
      "record": 4,
      "class": "tool_call",
      "activity_id": 4,
      "values": {
        "/identity_basis_id": 1
      },
      "why": "item_1 is minted by the exec processor; claiming it is the model's call id would let a consumer join it with a native session's call ids, which it cannot match."
    },
    {
      "id": "server-folded-into-name",
      "record": 4,
      "class": "tool_call",
      "activity_id": 4,
      "values": {
        "/tool_name": "fnd1/echo_record"
      },
      "why": "The source reports server and tool separately; Journal never composes a tool name."
    },
    {
      "id": "failed-as-success",
      "record": 7,
      "class": "tool_call",
      "activity_id": 2,
      "values": {
        "/status_id": 1
      },
      "why": "The item reports status failed; a result with content is not a success."
    },
    {
      "id": "model-request-observed",
      "record": 4,
      "class": "tool_call",
      "activity_id": 1,
      "values": {
        "/tool_call_uid": "item_1"
      },
      "why": "A started invocation is not the model's request; no response owner, model call id or permission decision follows from it."
    }
  ]
}
